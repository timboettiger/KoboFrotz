# KoboFrotz Build Configuration
# Copy this file to kobo-build.conf and adjust the paths
#
# This file is sourced by build-kobo.sh

# Path to Kobo Cross-Compilation Toolchain
# If using setup-toolchain.sh, this will be set automatically
# Default (local): ./toolchain/arm-kobo-linux-gnueabihf
# Default (home):  ~/x-tools/arm-kobo-linux-gnueabihf
#KOBO_TOOLCHAIN=$HOME/x-tools/arm-kobo-linux-gnueabihf

# Path to Qt for Kobo (cross-compiled)
# If using setup-toolchain.sh, this will be set automatically
# Default (local): ./toolchain/qt-kobo
# Default (home):  ~/qt-kobo
#QT_KOBO=$HOME/qt-kobo

# Installation path on the Kobo for the app
# Default: /mnt/onboard/.adds/kobofrotz
#KOBO_APP_DIR=/mnt/onboard/.adds/kobofrotz

# Path to Qt libraries on the Kobo
# Default: /mnt/onboard/.adds/qt-linux-5.15-kobo/lib
#KOBO_QT_LIB_DIR=/mnt/onboard/.adds/qt-linux-5.15-kobo/lib
